# Hugo build output
public/

# Hugo generated resources
resources/_gen/

# Hugo lock file
.hugo_build.lock

# Hugo module cache
_vendor/

# Font subsetting cache
.cache/

# Generated sticker sheet (built from content/stickers/stickers.svg)
assets/stickers/

# Generated Font Awesome (built from assets/fontawesome/ + assets/fa-custom/)
static/assets/fa/

# Large static files
static/climbing/
static/drone/

# Binary content files (images, media, documents)
**/*.jpg
**/*.jpeg
**/*.png
**/*.webp
**/*.mp4
**/*.wav
**/*.ogg
**/*.mp3
**/*.pdf
**/*.zip
**/*.ttf
**/*.woff
**/*.woff2
**/*.svg
**/*.pgn
**/*.stl
**/*.xcf

# Social-card source is a build input (assets/), not content media: it is
# processed into a 1200x630 og:image by layouts/_default/baseof.html.
!assets/og/*.png

# Custom Font Awesome icons, baked into the font by scripts/fontawesome.py
!assets/fa-custom/*.svg

# Python (uv)
.venv/

# Node
node_modules/
__pycache__/

# Editor
.zed/

# LLM
CLAUDE.md

# Check reports
reports/

# Personal task tracker
TODO.md

# Other
ignored/

!content/stickers/stickers.svg
