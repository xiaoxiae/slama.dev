#!/usr/bin/env fish

# Hugo site management script

function stickers
    echo "Building sticker sheet..."
    if not command -q inkscape
        echo "  NOTE: inkscape is not installed, so the sticker sheet will be limited."
        echo "        Install it (e.g. sudo pacman -S inkscape) for the full effect."
    end
    uv run python scripts/stickers.py
end

function serve
    echo "Starting Hugo development server..."
    if pgrep -f "hugo server" > /dev/null
        echo "ERROR: Hugo seems to be running already."
        return 1
    end

    stickers

    hugo server -D -F --cleanDestinationDir
end

function clean
    echo "Cleaning Hugo site..."
    rm -rf public resources/_gen
    echo "Clean complete."
end

function build
    echo "Building Hugo site..."
    if pgrep -f "hugo server" > /dev/null
        echo "ERROR: Hugo server seems to be running already."
        return 1
    end

    for tool in hugo uv typst ffmpeg ffprobe cwebp
        if not command -q $tool
            echo "ERROR: required tool '$tool' is not installed."
            switch $tool
                case typst
                    echo "  Install with: cargo install typst-cli"
                case ffmpeg ffprobe cwebp
                    echo "  Install the system package (on Arch, cwebp ships in 'libwebp-utils': sudo pacman -S libwebp-utils)"
            end
            return 1
        end
    end

    echo "Processing climbing content..."
    uv run python scripts/climbing.py build; or return 1

    echo "Processing drone content..."
    uv run python scripts/drone.py build; or return 1

    echo "Generating lightext images..."
    uv run python scripts/lightext.py content/light/index.md; or return 1

    stickers

    echo "Generating CV PDF..."
    typst compile --root . content/cv/cv.typ static/cv.pdf; or return 1

    hugo --minify --cleanDestinationDir; or return 1

    echo "Subsetting fonts..."
    uv run python scripts/subset_fonts.py; or return 1

    echo "Generating honeypot files..."
    uv run python scripts/secrets.py; or return 1

    # Must stay last: anything writing into public/ after this re-stamps it.
    echo "Restoring mtimes on unchanged output..."
    uv run python scripts/restore_mtimes.py; or return 1
end

function check
    set -l errors 0
    set -l report_dir reports
    mkdir -p $report_dir

    # Check for required tools
    if not command -q lychee
        echo "ERROR: lychee is not installed. Install with: cargo install lychee"
        return 1
    end
    if not command -q npx
        echo "ERROR: npm/npx is not installed."
        return 1
    end

    # Start server for accessibility testing
    echo "Starting local server..."
    hugo server --quiet --port 13130 &
    set hugo_pid $last_pid

    # Wait for server to be ready
    while not curl -s http://localhost:13130 > /dev/null 2>&1
        sleep 0.1
    end

    # Link checking
    echo "Running lychee link checker..."
    lychee --timeout 5 --root-dir public/ \
        --exclude 'public/manim/\d+$' \
        --exclude 'public/motion-canvas/\d+$' \
        --exclude 'public/lecture-notes/' \
        --exclude 'openstreetmap\.org/\?mlat' \
        'public/**/*.html' > $report_dir/lychee.txt 2>&1
    if test $status -ne 0
        set errors (math $errors + 1)
        echo "  FAILED - see $report_dir/lychee.txt"
    else
        echo "  OK"
    end

    # Wait for server to be ready
    while not curl -s http://localhost:13130 > /dev/null 2>&1
        sleep 0.1
    end

    # Accessibility testing
    echo "Running pa11y accessibility checker..."
    npx pa11y-ci --sitemap http://localhost:13130/sitemap.xml > $report_dir/pa11y.txt 2>&1
    if test $status -ne 0
        set errors (math $errors + 1)
        echo "  FAILED - see $report_dir/pa11y.txt"
    else
        echo "  OK"
    end

    echo "Stopping local server..."
    kill $hugo_pid 2>/dev/null

    if test $errors -gt 0
        echo "Check completed with $errors error(s). Reports in $report_dir/"
        return 1
    end
    echo "All checks passed."
end

function check_localhost
    echo "Checking for localhost references..."
    if grep -r "localhost:1313" public/**/*.html > /dev/null 2>&1
        echo "ERROR: Found 'localhost' in HTML files, not uploading!"
        return 1
    else
        echo "     Check passed: No 'localhost' found."
        return 0
    end
end

function upload
    set -l mode $argv[1]

    echo "Uploading site to VPS..."

    # Check for localhost references first
    if not check_localhost
        return 1
    end

    if test "$mode" = "--full"
        echo "Syncing files to VPS (full checksum verification)..."
        rsync -av --checksum --delete public/ slama-deploy@slama.dev:/var/www/slama.dev/
    else
        echo "Syncing files to VPS..."
        rsync -av --delete public/ slama-deploy@slama.dev:/var/www/slama.dev/
    end

    if test $status -ne 0
        echo "ERROR: rsync failed!"
        return 1
    end

    echo "Upload complete! (redirects live via the infra repo: tools/redirects.py + pyinfra)"
end

# Main script logic
switch $argv[1]
    case "serve"
        serve
    case "clean"
        clean
    case "stickers"
        stickers
    case "build"
        build
    case "check"
        check
    case "upload"
        upload $argv[2]
    case "all"
        build && upload $argv[2]
    case ""
        build && upload $argv[2]
    case "*"
        echo "Usage: ./site [serve|clean|stickers|build|check|upload|all]"
        echo ""
        echo "Commands:"
        echo "  serve   - Start development server with drafts and future posts"
        echo "  clean   - Clean generated files"
        echo "  stickers - Rebuild the sticker sheet from content/stickers/stickers.svg"
        echo "  build   - Build the site (minified)"
        echo "  check   - Run all checks (html-validate, lychee, pa11y)"
        echo "  upload  - Check for localhost and upload to VPS"
        echo "            add --full for a checksum-verified pass"
        echo "  all     - Build and upload (default)"
end
